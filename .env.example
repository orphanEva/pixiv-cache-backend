APP_NAME=pixiv-cache-backend
# Set the same password here and in MYSQL_PASSWORD.
DATABASE_URL=mysql+asyncmy://pixiv:REPLACE_MYSQL_PASSWORD@mysql:3306/pixiv_cache?charset=utf8mb4
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_URL=redis://redis:6379/0
STORAGE_ROOT=/data/pixiv
PIXIV_REFRESH_TOKEN=
REMOTE_CHECK_TTL_SECONDS=0
LOCK_TTL_SECONDS=180
LOCK_WAIT_SECONDS=30
SERVE_STALE_ON_REMOTE_UNAVAILABLE=true
MAX_ASSET_BYTES=157286400
DOWNLOAD_TIMEOUT_SECONDS=120
# Required: generate a random key at least 32 characters long
API_KEY=
# Default is local-only. Use a reverse proxy with HTTPS for remote clients.
API_BIND_ADDRESS=127.0.0.1
