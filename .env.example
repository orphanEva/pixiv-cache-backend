APP_NAME=pixiv-cache-backend
# REQUIRED: manually initialize NEW pixiv_archive using sql/pixiv_archive.sql
# Existing populated databases require a separate, data-preserving migration.
DATABASE_URL=mysql+asyncmy://pixiv:REPLACE_WITH_YOUR_PASSWORD@YOUR_MYSQL_HOST:3306/pixiv_archive?charset=utf8mb4
REDIS_URL=redis://redis:6379/0
STORAGE_ROOT=/data/pixiv
PIXIV_REFRESH_TOKEN=
REMOTE_CHECK_TTL_SECONDS=0
LOCK_TTL_SECONDS=180
LOCK_WAIT_SECONDS=30
SERVE_STALE_ON_REMOTE_UNAVAILABLE=true
MAX_ASSET_BYTES=157286400
DOWNLOAD_TIMEOUT_SECONDS=120
API_KEY=
API_BIND_ADDRESS=127.0.0.1
