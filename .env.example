APP_NAME=pixiv-cache-backend
# REQUIRED: manually initialize NEW pixiv_archive using sql/pixiv_archive.sql
DATABASE_URL=mysql+asyncmy://pixiv:REPLACE_WITH_YOUR_PASSWORD@YOUR_MYSQL_HOST:3306/pixiv_archive?charset=utf8mb4
REDIS_URL=redis://redis:6379/0
STORAGE_ROOT=/data/pixiv
SCHEMA_CHECK_ON_STARTUP=true

# Manual Pixiv credentials (optional when PIXIV_AUTO_AUTH=true).
PIXIV_REFRESH_TOKEN=
PIXIV_COOKIE=

# Automatic credential recovery. Credentials stay in .env; derived token/cookie
# caches are written under /data/pixiv/auth with restrictive file permissions.
PIXIV_AUTO_AUTH=false
PIXIV_USERNAME=
PIXIV_PASSWORD=
# Optional: base32 secret or otpauth:// URI for unattended 2FA.
PIXIV_TOTP_SECRET=
PIXIV_AUTH_CACHE_DIR=/data/pixiv/auth
PIXIV_AUTO_LOGIN_COOLDOWN_SECONDS=900
PIXIV_BROWSER_TIMEOUT_SECONDS=45

PIXIV_WEB_USER_AGENT=Mozilla/5.0
PIXIV_WEB_ACCEPT_LANGUAGE=zh-CN,zh;q=0.9,en;q=0.8
PIXIV_WEB_LOCALE=zh-CN

REMOTE_CHECK_TTL_SECONDS=0
PIXIV_DEEP_IMAGE_CHECK=false
CACHE_LOCK_PREFIX=pixiv-cache:
LOCK_TTL_SECONDS=180
LOCK_WAIT_SECONDS=30
SERVE_STALE_ON_REMOTE_UNAVAILABLE=true
MAX_ASSET_BYTES=157286400
STORAGE_AUDIT_MAX_FINDINGS=200
STORAGE_MIN_FREE_BYTES=2147483648
STORAGE_PART_STALE_SECONDS=86400
STORAGE_ORPHAN_GRACE_SECONDS=86400
DOWNLOAD_TIMEOUT_SECONDS=120
API_KEY=
API_BIND_ADDRESS=127.0.0.1

UGOIRA_GENERATE_MP4=true
UGOIRA_KEEP_EXTRACTED_FRAMES=false
UGOIRA_MAX_FRAMES=10000
UGOIRA_MAX_UNCOMPRESSED_BYTES=2147483648
FFMPEG_BINARY=ffmpeg
UGOIRA_PREFER_ORIGINAL=true

ARCHIVE_JOB_STATUS_TTL_SECONDS=604800
ARCHIVE_JOB_DEDUPE_TTL_SECONDS=21600
ARCHIVE_JOB_CLAIM_IDLE_MS=900000
ARCHIVE_WORKER_BLOCK_MS=5000
ARCHIVE_WORKER_HEARTBEAT_TTL_SECONDS=30

MAINTENANCE_FREEZE_TTL_SECONDS=7200
MAINTENANCE_FREEZE_WAIT_SECONDS=5
MAINTENANCE_WAIT_FOR_WRITERS_SECONDS=1800
# Optional privileged/admin DB URL for destructive restore operations.
MAINTENANCE_DATABASE_URL=
BACKUP_ROOT=/data/pixiv/.backups
