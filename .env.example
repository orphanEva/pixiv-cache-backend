APP_NAME=pixiv-cache-backend
# REQUIRED: manually create the external MySQL database and tables
# with sql/mysql-schema.sql, then supply a pre-existing user with CRUD privileges.
# For MySQL running on Docker host use host.docker.internal and add host-gateway
# to your local Compose config on Linux; for a remote server use its IP/hostname.
DATABASE_URL=mysql+asyncmy://pixiv:REPLACE_WITH_YOUR_PASSWORD@YOUR_MYSQL_HOST:3306/pixiv_cache?charset=utf8mb4
REDIS_URL=redis://redis:6379/0
STORAGE_ROOT=/data/pixiv
PIXIV_REFRESH_TOKEN=
REMOTE_CHECK_TTL_SECONDS=0
LOCK_TTL_SECONDS=180
LOCK_WAIT_SECONDS=30
SERVE_STALE_ON_REMOTE_UNAVAILABLE=true
MAX_ASSET_BYTES=157286400
DOWNLOAD_TIMEOUT_SECONDS=120
# Required: generate a random key at least 32 characters long
API_KEY=
API_BIND_ADDRESS=127.0.0.1
