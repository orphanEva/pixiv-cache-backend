new file mode 100644
index 0000000..0f6f544
--- /dev/null
+++ b/app/clients/subscription_parser.py
@@ -0,0 +1,57 @@
+"""非公开 Web 接口的显式结构解析；不把作品缩略图 ID 猜成合集 ID。"""
+from __future__ import annotations
+
+
+def positive_id(value) -> str:
+    if isinstance(value, bool) or not str(value or "").isdigit() or int(value) <= 0:
+        raise ValueError("Invalid remote ID")
+    return str(int(value))
+
+
+def parse_watchlist_page(payload: dict, kind: str, page_number: int) -> dict:
+    body = payload.get("body")
+    if kind not in ("novel", "manga") or not isinstance(body, dict):
+        raise ValueError("Unknown watchlist body")
+    page = body.get("page") if isinstance(body.get("page"), dict) else {}
+    ids = page.get("watchedSeriesIds")
+    if ids is not None:
+        if not isinstance(ids, list):
+            raise ValueError("Invalid watchedSeriesIds")
+        result = [int(positive_id(x)) for x in ids]
+    else:
+        containers = [page, body]
+        thumbnails = body.get("thumbnails")
+        if kind == "novel" and isinstance(thumbnails, dict):
+            containers.append(thumbnails)
+        keys = ("novelSeries", "novel_series", "series", "seriesList") if kind == "novel" else ("illustSeries", "mangaSeries", "series", "seriesList")
+        entries = next((c[k] for c in containers for k in keys if isinstance(c.get(k), list)), None)
+        if entries is None:
+            raise ValueError("Unknown watchlist response: no series list")
+        result = []
+        for entry in entries:
+            if not isinstance(entry, dict):
+                raise ValueError("Invalid watchlist series entry")
+            nested = entry.get("series") or {}
+            if not isinstance(nested, dict):
+                raise ValueError("Invalid nested series")
+            value = entry.get("seriesId") or entry.get("novelSeriesId") or entry.get("series_id") or nested.get("id") or entry.get("id")
+            result.append(int(positive_id(value)))
+    if len(result) != len(set(result)):
+        raise ValueError("Duplicate series IDs within watchlist page")
+    has_next = None
+    for c in (page, body):
+        for key in ("hasNextPage", "hasNext", "has_next"):
+            if isinstance(c.get(key), bool):
+                has_next = c[key]
+                break
+        maximum = c.get("maxPage", c.get("lastPage"))
+        if maximum is not None:
+            maximum = int(maximum)
+            if maximum < 0:
+                raise ValueError("Invalid watchlist page count")
+            has_next = page_number < maximum
+        if has_next is not None:
+            break
+    if not result and has_next is True:
+        raise ValueError("Empty watchlist page claims more pages")
+    return {"series_ids": result, "has_next": has_next}
