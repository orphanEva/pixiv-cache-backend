+    async def discover_following_page(self, user_id: int, restrict: str, next_params: dict | None = None) -> dict:
+        """只读取关注列表；不会在 Pixiv 上关注/取消关注任何用户。"""
+        from urllib.parse import urlparse, parse_qs
+        offset = int((next_params or {}).get("offset", 0))
+        if offset < 0 or restrict not in ("public", "private"):
+            raise ValueError("Invalid following cursor")
+        data = to_dict(await self._call(
+            self.api.user_following, user_id, restrict=restrict, offset=offset
+        ))
+        if not isinstance(data, dict) or not isinstance(data.get("user_previews"), list):
+            raise ValueError("Unknown Pixiv following response")
+        ids = []
+        for preview in data["user_previews"]:
+            uid = (preview.get("user") or {}).get("id") if isinstance(preview, dict) else None
+            if isinstance(uid, bool) or not str(uid or "").isdigit() or int(uid) <= 0:
+                raise ValueError("Following response has invalid user ID")
+            ids.append(str(uid))
+        next_url = data.get("next_url")
+        cursor = None
+        if next_url:
+            url = urlparse(next_url)
+            if url.scheme != "https" or url.hostname != "app-api.pixiv.net" or url.path != "/v1/user/following":
+                raise ValueError("Untrusted following cursor")
+            query = parse_qs(url.query)
+            next_offset = int(query.get("offset", ["-1"])[0])
+            if next_offset <= offset or not ids:
+                raise ValueError("Following pagination did not advance")
+            cursor = {"offset": next_offset}
+        return {"ids": ids, "next_params": cursor}
