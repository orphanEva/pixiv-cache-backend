diff --git a/app/core/remote_control.py b/app/core/remote_control.py
new file mode 100644
index 0000000..747ed5c
--- /dev/null
+++ b/app/core/remote_control.py
@@ -0,0 +1,108 @@
+"""跨进程外部访问闸门。默认关闭，任何检查失败都不放行。
+
+环境开关 + Redis 人工确认同时满足才允许访问；限速不代表 Pixiv 授权。
+"""
+from __future__ import annotations
+
+import asyncio
+import json
+from contextlib import asynccontextmanager
+from datetime import datetime, timezone
+
+from app.core.config import get_settings
+from app.core.errors import RemoteAccessPaused
+from app.core.redis_client import get_redis
+from app.core.redis_lock import RenewingRedisLock
+
+
+class RemoteControl:
+    def __init__(self, redis_client=None):
+        self.settings = get_settings()
+        self.redis = redis_client if redis_client is not None else get_redis()
+        self.key = self.settings.remote_control_key
+
+    async def status(self) -> dict:
+        raw = await self.redis.get(self.key)
+        state = json.loads(raw) if raw else {"paused": True, "reason": "not_approved"}
+        return {
+            **state,
+            "environment_enabled": self.settings.pixiv_remote_enabled,
+            "allowed": self.settings.pixiv_remote_enabled and state.get("paused") is False,
+            "min_interval_seconds": self.settings.remote_min_interval_seconds,
+            "daily_request_limit": self.settings.remote_daily_request_limit,
+        }
+
+    async def require_allowed(self) -> None:
+        if not self.settings.pixiv_remote_enabled:
+            raise RemoteAccessPaused("Remote access disabled by PIXIV_REMOTE_ENABLED")
+        try:
+            state = await self.status()
+        except Exception:
+            raise RemoteAccessPaused("Remote control unavailable; refusing outbound requests") from None
+        if not state["allowed"]:
+            raise RemoteAccessPaused("Remote access paused: " + str(state.get("reason", "operator")))
+
+    async def pause(self, reason: str = "operator") -> dict:
+        # 只接受调用方生成的安全原因码，不保存上游响应/Token/Cookie。
+        state = {"paused": True, "reason": reason[:80], "updated_at": datetime.now(timezone.utc).isoformat()}
+        await self.redis.set(self.key, json.dumps(state))
+        return state
+
+    async def resume(self) -> dict:
+        if not self.settings.pixiv_remote_enabled:
+            raise RemoteAccessPaused("Set PIXIV_REMOTE_ENABLED only after platform approval; restart all processes")
+        state = {"paused": False, "reason": "operator_confirmed", "updated_at": datetime.now(timezone.utc).isoformat()}
+        await self.redis.set(self.key, json.dumps(state))
+        return state
+
+    @asynccontextmanager
+    async def request(self):
+        """元数据、OAuth、Web、媒体下载共用锁和请求预算；不跨过远端限流。"""
+        await self.require_allowed()
+        lock = RenewingRedisLock(self.redis, self.key + ":request-lock", ttl_seconds=180, wait_seconds=30)
+        try:
+            acquired = await lock.acquire()
+        except Exception:
+            raise RemoteAccessPaused("Remote request gate unavailable") from None
+        if not acquired:
+            raise RemoteAccessPaused("Remote request gate busy; request was not sent")
+        try:
+            while True:
+                await self.require_allowed()
+                seconds, micros = await self.redis.time()
+                now = float(seconds) + float(micros) / 1e6
+                next_at = float(await self.redis.get(self.key + ":next-at") or 0)
+                delay = next_at - now
+                if delay <= 0:
+                    break
+                await asyncio.sleep(min(delay, 1.0))
+                lock.ensure_alive()
+            day = datetime.fromtimestamp(now, timezone.utc).strftime("%Y%m%d")
+            budget_key = self.key + ":requests:" + day
+            count = int(await self.redis.get(budget_key) or 0)
+            if count >= self.settings.remote_daily_request_limit:
+                await self.pause("daily_budget_exhausted")
+                raise RemoteAccessPaused("Daily request budget exhausted; manual review required")
+            # 在发请求前消耗预算；失败也计数，防止认证/超时形成重试风暴。
+            await self.redis.incr(budget_key)
+            await self.redis.expire(budget_key, 172800)
+            await self.redis.set(self.key + ":next-at", str(now + self.settings.remote_min_interval_seconds))
+            lock.ensure_alive()
+            yield
+        finally:
+            await lock.release()
+
+
+@asynccontextmanager
+async def remote_request():
+    """可注入测试替身，但生产路径统一使用 Redis 闸门。"""
+    async with RemoteControl().request():
+        yield
+
+
+async def check_remote_response(status_code: int, retry_after: str | None = None) -> None:
+    if status_code in (401, 403, 429):
+        reason = {401: "authentication_rejected", 403: "access_rejected", 429: "rate_limited"}[status_code]
+        await RemoteControl().pause(reason)
+        # 不根据 Retry-After 自动恢复；人工审查前一直保持暂停。
+        raise RemoteAccessPaused(f"Remote HTTP {status_code}; all external access paused")
