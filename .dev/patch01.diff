+@router.get("/sources/{source_id}/targets")
+async def list_targets(source_id: int, page: int = Query(1, ge=1),
+    page_size: int = Query(50, ge=1, le=200), session: AsyncSession = Depends(get_session)):
+    from sqlalchemy import func
+    condition = SyncTarget.source_id == source_id
+    total = (await session.execute(select(func.count()).select_from(SyncTarget).where(condition))).scalar_one()
+    rows = (await session.execute(select(SyncTarget).where(condition)
+        .order_by(SyncTarget.target_type, SyncTarget.remote_id)
+        .offset((page - 1) * page_size).limit(page_size))).scalars().all()
+    return {"items": [{"source_id": r.source_id, "type": r.target_type, "remote_id": r.remote_id,
+        "active": r.active, "enabled": r.enabled, "last_checked_at": r.last_checked_at,
+        "last_success_at": r.last_success_at, "last_error": r.last_error,
+        "checkpoint": r.frontier_json or {}} for r in rows],
+        "page": page, "page_size": page_size, "total": total}
