+@router.post("/plan/c")
+async def configure_c_plan(body: CPlanRequest, session: AsyncSession = Depends(get_session)):
+    """只创建/更新本地配置，不发 Pixiv 请求、不立即入队，默认全部暂停。"""
+    sources = []
+    selections = (
+        (body.public_bookmarks, SyncSourceType.BOOKMARKS, "self", SyncRestrict.PUBLIC),
+        (body.private_bookmarks, SyncSourceType.BOOKMARKS, "self", SyncRestrict.PRIVATE),
+        (body.public_following, SyncSourceType.FOLLOWING, "self", SyncRestrict.PUBLIC),
+        (body.private_following, SyncSourceType.FOLLOWING, "self", SyncRestrict.PRIVATE),
+        (body.novel_watchlist, SyncSourceType.WATCHLIST, "novel", SyncRestrict.PUBLIC),
+        (body.manga_watchlist, SyncSourceType.WATCHLIST, "manga", SyncRestrict.PUBLIC),
+    )
+    for selected, kind, remote_id, restrict in selections:
+        if not selected:
+            continue
+        sources.append(await _upsert_source(
+            session, source_type=kind, remote_user_id=remote_id, restrict=restrict,
+            include_illust=(remote_id == "manga") if kind == SyncSourceType.WATCHLIST else body.include_illust,
+            include_novel=(remote_id == "novel") if kind == SyncSourceType.WATCHLIST else body.include_novel,
+            interval_seconds=body.interval_seconds, run_now=False, enabled=body.enabled,
+            max_items_per_run=body.max_items_per_run,
+        ))
+    return {"sources": sources, "remote_requests_sent": 0}
+
